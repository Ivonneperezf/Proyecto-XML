      <ingrediente cantidad="1" unidad="cucharadita">Esencia de vainilla</ingrediente>
    </ingredientes>
    <preparacion>
      <paso orden="1">Lavar y desinfectar las fresas.</paso>
      <paso orden="2">Colocar las fresas, leche, azúcar y esencia de vainilla en una licuadora.</paso>
      <paso orden="3">Licuar hasta obtener una mezcla homogénea.</paso>
      <paso orden="4">Servir en vasos altos con hielo al gusto.</paso>
    </preparacion>
    <tiempo total="10" unidad="minutos"/>
    <porciones cantidad="2"/>
    <video url="https://youtu.be/bQoRxGo33bE"/>
    <enlace url="https://www.recetasnestle.com.mx/recetas/batido-de-fresa"/>
    <notas>Se puede añadir un poco de crema batida por encima.</notas>
  </receta>
