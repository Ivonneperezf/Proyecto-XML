  <!-- Receta 1-->
  <receta id="r001" categoria="Postre" dificultad="Media">
    <nombre>Pastel de Chocolate</nombre>
    <descripcion>Delicioso pastel de chocolate esponjoso y húmedo.</descripcion>
    <ingredientes>
      <ingrediente cantidad="200" unidad="g">Harina</ingrediente>
      <ingrediente cantidad="100" unidad="g">Cacao en polvo</ingrediente>
      <ingrediente cantidad="150" unidad="g">Azúcar</ingrediente>
      <ingrediente cantidad="3" unidad="u">Huevos</ingrediente>
      <ingrediente cantidad="100" unidad="ml">Leche</ingrediente>
      <ingrediente cantidad="100" unidad="g">Mantequilla</ingrediente>
    </ingredientes>
    <preparacion>
      <paso orden="1">Precalentar el horno a 180°C.</paso>
      <paso orden="2">Mezclar los ingredientes secos.</paso>
      <paso orden="3">Añadir los ingredientes líquidos y mezclar bien.</paso>
      <paso orden="4">Verter la mezcla en un molde engrasado.</paso>
      <paso orden="5">Hornear durante 30 minutos.</paso>
    </preparacion>
    <tiempo total="60" unidad="minutos"/>
    <porciones cantidad="8"/>
    <video url="https://youtu.be/n4gHFwKEJ2Y"/>
    <enlace url="https://www.recetasnestle.com.mx/recetas/pastel-chocolate"/>
    <notas>Se puede decorar con frutas o crema batida.</notas>
  </receta>
  <!-- Receta 2-->
  <receta id="r002" categoria="Entrada" dificultad="Baja">
    <nombre>Ensalada César</nombre>
    <descripcion>Clásica ensalada con lechuga, pollo y aderezo César.</descripcion>
    <ingredientes>
      <ingrediente cantidad="200" unidad="g">Pechuga de pollo</ingrediente>
      <ingrediente cantidad="150" unidad="g">Lechuga romana</ingrediente>
      <ingrediente cantidad="50" unidad="g">Queso parmesano</ingrediente>
      <ingrediente cantidad="50" unidad="g">Crutones</ingrediente>
      <ingrediente cantidad="100" unidad="ml">Aderezo César</ingrediente>
    </ingredientes>
    <preparacion>
      <paso orden="1">Cocinar la pechuga de pollo y cortarla en tiras.</paso>
      <paso orden="2">Lavar y cortar la lechuga.</paso>
      <paso orden="3">Mezclar todos los ingredientes en un bol.</paso>
      <paso orden="4">Añadir el aderezo y mezclar bien.</paso>
    </preparacion>
    <tiempo total="20" unidad="minutos"/>
    <porciones cantidad="4"/>
    <video url="https://youtu.be/ef-gPM9UcRo"/>
    <enlace url="https://diegodoal.com/recetas/ensalada-cesar"/>
    <notas>Se puede añadir pollo a la parrilla para más sabor.</notas>
  </receta>
  <!-- Receta 3-->
  <receta id="r003" categoria="Plato Principal" dificultad="Alta">
    <nombre>Paella Valenciana</nombre>
    <descripcion>Tradicional paella con mariscos y arroz.</descripcion>
    <ingredientes>
      <ingrediente cantidad="500" unidad="g">Arroz</ingrediente>
      <ingrediente cantidad="200" unidad="g">Mariscos surtidos</ingrediente>
      <ingrediente cantidad="100" unidad="g">Guisantes</ingrediente>
      <ingrediente cantidad="1" unidad="u">Pimiento rojo</ingrediente>
      <ingrediente cantidad="2" unidad="u">Tomates</ingrediente>
      <ingrediente cantidad="1" unidad="u">Cebolla</ingrediente>
      <ingrediente cantidad="1" unidad="u">Diente de ajo</ingrediente>
      <ingrediente cantidad="1" unidad="l">Caldo de pescado</ingrediente>
      <ingrediente cantidad="1" unidad="cucharadita">Azafrán</ingrediente>
    </ingredientes>
    <preparacion>
      <paso orden="1">Sofreír la cebolla, ajo y pimiento.</paso>
      <paso orden="2">Añadir los tomates y cocinar hasta que estén blandos.</paso>
      <paso orden="3">Incorporar los mariscos y el arroz.</paso>
      <paso orden="4">Verter el caldo caliente y añadir el azafrán.</paso>
      <paso orden="5">Cocinar a fuego medio hasta que el arroz esté en su punto.</paso>
    </preparacion>
    <tiempo total="90" unidad="minutos"/>
    <porciones cantidad="6"/>
    <video url="https://youtu.be/zrSyyNugKYo"/>
    <enlace url="https://www.directoalpaladar.com/recetas-de-arroces/paella-valenciana-receta-tradicional"/>
    <notas>Es importante no remover el arroz durante la cocción.</notas>
  </receta>
  <!-- Receta 4-->
  <receta id="r004" categoria="Postre" dificultad="Baja">
    <nombre>Flan Casero</nombre>
    <descripcion>Flan suave y cremoso con caramelo.</descripcion>
    <ingredientes>
      <ingrediente cantidad="500" unidad="ml">Leche</ingrediente>
      <ingrediente cantidad="100" unidad="g">Azúcar</ingrediente>
      <ingrediente cantidad="4" unidad="u">Huevos</ingrediente>
      <ingrediente cantidad="1" unidad="cucharadita">Esencia de vainilla</ingrediente>
    </ingredientes>
    <preparacion>
      <paso orden="1">Caramelizar el azúcar en un molde apto para horno.</paso>
      <paso orden="2">Batir los huevos con el azúcar y la esencia de vainilla.</paso>
      <paso orden="3">Añadir la leche caliente a la mezcla de huevos.</paso>
      <paso orden="4">Verter la mezcla en el molde caramelizado.</paso>
      <paso orden="5">Cocinar al baño maría en el horno durante 45 minutos.</paso>
    </preparacion>
    <tiempo total="60" unidad="minutos"/>
    <porciones cantidad="6"/>
    <video url="https://youtu.be/WfDpQBkCUXo"/>
    <enlace url="https://www.goodnes.com/es/la-lechera/recetas/flan-tradicional/"/>
    <notas>Dejar enfriar completamente antes de desmoldar.</notas>
  </receta>
  <!-- Receta 5-->
  <receta id="r005" categoria="Bebida" dificultad="Baja">
    <nombre>Batido de Fresas</nombre>
    <descripcion>Refrescante batido de fresas con leche.</descripcion>
    <ingredientes>
      <ingrediente cantidad="200" unidad="g">Fresas</ingrediente>
      <ingrediente cantidad="250" unidad="ml">Leche</ingrediente>
