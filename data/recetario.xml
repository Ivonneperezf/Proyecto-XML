  <!-- Receta 11 -->
  <receta id="r011" categoria="Postre" dificultad="Media">
    <nombre>Tiramisu Italiano</nombre>
    <descripcion>Clásico postre italiano con capas de bizcocho, café y mascarpone.</descripcion>
